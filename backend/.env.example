# Lokalda ishga tushirish uchun shart emas — quyidagi standart qiymatlar avtomatik ishlatiladi.
# Productionga (Render) joylashtirganda shu fayldagi nomlar bilan muhit o'zgaruvchilarini kiriting.

# Postgres ulanish satri (Neon.tech'dan olinadi). Bo'sh qoldirilsa lokal SQLite ishlatiladi.
DATABASE_URL=

# Tasodifiy, uzun va maxfiy satr bilan almashtiring (masalan: openssl rand -hex 32)
JWT_SECRET=

# Admin panelga kirish uchun (siz tanlaysiz)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Backend qayerda joylashganini bildiradi (rasm manzillari shundan quriladi, R2 sozlanmagan bo'lsa)
PUBLIC_BASE_URL=http://localhost:8000

# Frontend qaysi manzillardan so'rov yuborishiga ruxsat berish (vergul bilan ajrating). Masalan:
# CORS_ORIGINS=https://qurilishmollari.pages.dev,https://qurilishmollarimarket.uz
CORS_ORIGINS=*

# Cloudflare R2 (rasm saqlash) — hammasi to'ldirilsa ishlatiladi, aks holda lokal diskka saqlanadi
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
